# Normalize all text files to LF in the repo and on checkout.
# This overrides per-machine core.autocrlf, so line endings stop being a
# platform problem: Prettier (endOfLine: "lf") and CI agree with the checkout.
* text=auto eol=lf

# Windows shell scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
