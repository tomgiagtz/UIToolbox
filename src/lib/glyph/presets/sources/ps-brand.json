    {
      "name": "PlayStation",
      "catalogId": "playstation",
      "enabled": [
        "ps-cross",
        "ps-circle",
        "ps-square",
        "ps-triangle",
        "ps-l1",
        "ps-r1",
        "ps-l2",
        "ps-r2",
        "ps-share",
        "ps-options",
        "ps-left-stick",
        "ps-right-stick",
        "ps-dpad-up",
        "ps-dpad-down",
