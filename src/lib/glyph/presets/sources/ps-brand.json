              "fill": "#ff6666"
            }
          }
        },
        "ps-cross": {
          "foreground": {
            "symbolPaints": {
              "fill": "#7db3e9"
            }
          }
        },
        "ps-square": {
          "foreground": {
            "symbolPaints": {
              "fill": "#ff69f8"
            }
          }
        }
      }
